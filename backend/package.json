{
  "name": "event-checkin-backend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node src/db/migrate.js",
    "migrate:test": "DATABASE_URL=$TEST_DATABASE_URL node src/db/migrate.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "test:concurrency": "bash ../test-results/run-concurrency.sh"
  },
  "dependencies": {
    "@google/generative-ai": "^0.15.0",
    "@sentry/node": "^10.70.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.0",
    "express": "^4.19.0",
    "express-rate-limit": "^7.3.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.0",
    "pg": "^8.12.0",
    "pino": "^9.3.0",
    "pino-http": "^10.2.0",
    "socket.io": "^4.7.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.11",
    "supertest": "^7.0.0",
    "vitest": "^4.1.11"
  }
}
